{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Шеф по остаткам",
  "version": "0.1.0",
  "identifier": "com.leftoverchef.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Шеф по остаткам",
        "width": 390,
        "height": 844,
        "minWidth": 320,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:leftover_chef.db"]
    }
  }
}
